+            SpvInstruction pcssLabel = context.Label(), plainLabel = context.Label(), mergeLabel = context.Label();
+            SpvInstruction enabled = context.FOrdGreaterThan(b, lightSize, zero);   // before the merge: it must precede the branch
+            context.SelectionMerge(mergeLabel, SelectionControlMask.MaskNone);
+            context.BranchConditional(enabled, pcssLabel, plainLabel);
+
+            context.AddLabel(plainLabel);
+            SpvInstruction plain = context.ImageSampleDrefExplicitLod(f32, image, pCoords, dRef, ImageOperandsMask.Lod, lod);
+            context.Branch(mergeLabel);
+
+            context.AddLabel(pcssLabel);
+            SpvInstruction raw = context.Image(declaration.ImageType, image);
+            SpvInstruction size3 = context.ImageQuerySizeLod(iv3, raw, context.Constant(s32, 0));
+            SpvInstruction sizeI = context.VectorShuffle(iv2, size3, size3, 0, 1);
+            SpvInstruction sizeF = context.ConvertSToF(v2, sizeI);
+            SpvInstruction maxI = context.ISub(iv2, sizeI, context.ConstantComposite(iv2, context.Constant(s32, 1), context.Constant(s32, 1)));
+            SpvInstruction zeroI = context.ConstantComposite(iv2, context.Constant(s32, 0), context.Constant(s32, 0));
+            SpvInstruction uv = context.VectorShuffle(v2, pCoords, pCoords, 0, 1);
+            SpvInstruction layerF = context.CompositeExtract(f32, pCoords, 2);
+            SpvInstruction layerI = context.ConvertFToS(s32, layerF);
+            SpvInstruction searchV = context.CompositeConstruct(v2, searchR, searchR);
