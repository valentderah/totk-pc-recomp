+            SpvInstruction iv2 = context.TypeVector(s32, 2), iv3 = context.TypeVector(s32, 3);
+            SpvInstruction zero = context.Constant(f32, 0f), one = context.Constant(f32, 1f);
+
+            SpvInstruction prmPtr = context.AccessChain(context.TypePointer(StorageClass.Uniform, v4), context.ConstantBuffers[SupportBuffer.Binding],
+                                                        context.Constant(s32, (int)SupportBufferField.Pcss));
+            SpvInstruction prm = context.Load(v4, prmPtr);
+            SpvInstruction lightSize = context.CompositeExtract(f32, prm, 0);
+            SpvInstruction minR = context.CompositeExtract(f32, prm, 1);
+            SpvInstruction maxR = context.CompositeExtract(f32, prm, 2);
+            SpvInstruction searchR = context.CompositeExtract(f32, prm, 3);
