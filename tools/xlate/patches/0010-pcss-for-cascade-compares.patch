+            SpvInstruction pcss = context.FMul(f32, acc, context.Constant(f32, 2f / PcssDisk.Length));
+            context.Branch(mergeLabel);
+
+            context.AddLabel(mergeLabel);
+            return context.Phi(f32, pcss, pcssLabel, plain, plainLabel);
+        }
