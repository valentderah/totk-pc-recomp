+            SpvInstruction sum = zero, count = zero;
+            for (int i = 0; i < PcssSearch.Length; i += 2)
+            {
+                SpvInstruction off = context.ConstantComposite(v2, context.Constant(f32, PcssSearch[i]), context.Constant(f32, PcssSearch[i + 1]));
