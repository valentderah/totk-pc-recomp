+                load.SourcesCount != 4 ||
+                load.GetSource(0) is not AstOperand { Type: OperandType.Constant } binding ||
+                load.GetSource(1) is not AstOperand { Type: OperandType.Constant, Value: 0 } ||
+                load.GetSource(2) is not AstOperand { Type: OperandType.Constant, Value: 58 } ||
