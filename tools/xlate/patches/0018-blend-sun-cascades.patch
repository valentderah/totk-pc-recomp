+        // TOTK: blending two sun cascades where one ends. The lighting shaders pick the cascade with a hard step,
+        // index = (depth > split0) + (depth > split1) + (depth > split2), the splits being element 58 .x .y .z of their
+        // lighting block (fp_c4), and shade from that cascade alone; a wall the split crosses then switches at once
+        // between the two cascades' looks, and the line moves with the camera. CaptureCascadeSplit keeps the depth and
+        // the splits of those compares in private variables; GenerateCascadeBlend, at each cascade compare, takes a
+        // second compare on the next cascade in the last part of the cascade's range and mixes the two. The second
+        // cascade's coordinates come from the first's by a scale and an offset, taken from the two cascades' lookup rows
+        // in the shader's own lighting block; that holds when the cascades share their axes (runtime/shadow_stable.c
+        // sets them up that way). cascade_blend.x is the band, as a fraction of the split distance (0: no blend, which
+        // the runtime keeps unless the cascades are its own).
+        private static bool HasCascadeArray(CodeGenContext context)
+        {
+            foreach (TextureDefinition texture in context.Properties.Textures.Values)
+            {
+                if ((texture.Type & (SamplerType.Mask | SamplerType.Array | SamplerType.Shadow)) ==
+                    (SamplerType.Texture2D | SamplerType.Array | SamplerType.Shadow))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
