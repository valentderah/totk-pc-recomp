# Reference checkouts of upstream projects (cloned locally, never committed)
/refs/

# Downloaded toolchain binaries and Python environments
/toolchain/
/.venv/
/.venv-py314/
__pycache__/

# Personal paths to game files and keys
/config.local.toml

