// Host-side action catalog. Game-specific consumer masks stay in the verified local build plan.
ACTION(JUMP, "Jump / climb jump / swim dash", KEY_SPACE, 0, B_X)
ACTION(SPRINT, "Sprint", KEY_LSHIFT, 0, B_B)
ACTION(CROUCH, "Crouch", KEY_LCTRL, 0, B_STICK_L)
ACTION(INTERACT, "Interact", KEY_E, 0, B_A)
ACTION(ATTACK, "Attack", KEY_MOUSE_L, 0, B_Y)
ACTION(BOW, "Bow aim", KEY_F, KEY_X, B_ZR)
ACTION(THROW, "Throw / dive", KEY_R, 0, B_R)
ACTION(GUARD, "Shield / target", KEY_MOUSE_R, KEY_Z, B_ZL)
ACTION(CANCEL, "Put away / drop / cancel", KEY_BACKSPACE, 0, -1)
ACTION(ABILITY, "Use ability", KEY_Q, 0, B_L)
ACTION(CAMERA, "Change camera view", KEY_C, 0, B_STICK_R)
ACTION(INVENTORY, "Inventory", KEY_TAB, 0, B_PLUS)
ACTION(MAP, "Map", KEY_M, 0, B_MINUS)
ACTION(SELECT_WEAPON, "Select weapon", KEY_3, 0, B_RIGHT)
ACTION(SELECT_SHIELD, "Select shield", KEY_1, 0, B_LEFT)
ACTION(SELECT_ITEM, "Select item / material", KEY_2, 0, B_UP)
ACTION(WHISTLE, "Whistle", KEY_4, 0, B_DOWN)
ACTION(MOVE_LEFT, "Move left", KEY_A, 0, -1)
ACTION(MOVE_UP, "Move forward", KEY_W, 0, -1)
ACTION(MOVE_RIGHT, "Move right", KEY_D, 0, -1)
ACTION(MOVE_DOWN, "Move backward", KEY_S, 0, -1)
ACTION(LOOK_LEFT, "Look left", KEY_LEFT, 0, -1)
ACTION(LOOK_UP, "Look up", KEY_UP, 0, -1)
ACTION(LOOK_RIGHT, "Look right", KEY_RIGHT, 0, -1)
ACTION(LOOK_DOWN, "Look down", KEY_DOWN, 0, -1)
ACTION(LOCKON, "Lock on / camera target", KEY_MOUSE_R, KEY_Z, B_ZL)
