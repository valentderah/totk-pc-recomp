+// RomFS handles have their own lifetime lock. Saving never blocks streaming;
+// closing an overlay waits until readers have finished using its descriptor.
+static pthread_rwlock_t handle_lifetime=PTHREAD_RWLOCK_INITIALIZER;
+typedef struct { int away; } RomAccess;
+static RomAccess rom_access(int exclusive) {
+ RomAccess access={.away=runtime_core_away()};
+ int result=exclusive?pthread_rwlock_wrlock(&handle_lifetime):pthread_rwlock_rdlock(&handle_lifetime);
+ if(result)runtime_fail("RomFS handle lifetime lock");
+ return access;
+}
+static void rom_access_end(RomAccess *access) {
+ pthread_rwlock_unlock(&handle_lifetime);runtime_core_back(&access->away);
+}
+#define ROM_ACCESS(exclusive) RomAccess access __attribute__((cleanup(rom_access_end)))=rom_access(exclusive)
