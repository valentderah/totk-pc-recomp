#version 450
// Frame generation, the picture that is shown (vk_fg.c vk_fg_compose): the generated picture with this frame's HUD on
// it. The library interpolated the game's picture as it was before the HUD (hearts, map, prompts) was drawn, so that a
// heart never smears along with the mountain moving behind it. The HUD goes back on here, as the frame after the
// generated one shows it: a pixel of the game's float target that the HUD's draws changed takes this frame's pixel of
// the window texture, every other pixel the generated one.
// hud_tex is a copy of pic_tex taken before the HUD's first draw, so where no HUD was drawn the two are equal, and
// their difference is what the HUD added. Where that is more than a sixteenth of the pixel, the pixel is the HUD's.
// Less is the faint rim of an element, or a quad that is all but transparent: the map's quad left a scatter of
// pixels a rounding step of the R11G11B10F target apart, and taking those from the game's frame speckled the moving
// ground around the map. Such a pixel is the generated one with the HUD's small difference added, which is
// what blending the HUD onto it would give, up to that fraction of how far the pixel moved.
// What the screen shows of a frame the game drew is the window texture's bytes: the float target's linear values,
// sRGB-encoded by the game's last draw (the window texture is an sRGB target) and blitted as they are. So a pixel of
// the HUD is copied from the window texture, read as plain bytes, and a generated pixel, which is a linear value like
// the float target's, is encoded here and rounded to 8 bits by the store, as that last draw would have stored it: a
// place that does not move has the same byte in generated frames and in the game's.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D pic_tex;   // the game's float target at the frame's end, with the HUD
layout(binding = 1) uniform sampler2D hud_tex;   // its copy from before the HUD
layout(binding = 2) uniform sampler2D gen_tex;   // the generated picture, without HUD
layout(binding = 3) uniform sampler2D win_tex;   // this frame's window texture, its bytes (a UNORM view)
layout(binding = 4, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 size;
    int debug;   // 1: the HUD's pixels in magenta; 2: the picture before the HUD in place of the generated one
} pc;

vec3 srgb_encode(vec3 c) { return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308))); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    vec3 t = texelFetch(pic_tex, p, 0).rgb, h = texelFetch(hud_tex, p, 0).rgb, d = t - h;
    bool hud = any(greaterThan(abs(d), max(t, h) * (1.0 / 16.0) + 1.0 / 512.0));
    vec3 c;
    if (hud) c = texelFetch(win_tex, p, 0).rgb;
    else c = srgb_encode(clamp((pc.debug == 2 ? h : texelFetch(gen_tex, p, 0).rgb) + d, 0.0, 1.0));
    if (pc.debug == 1 && hud) c = vec3(1.0, 0.0, 1.0);
    imageStore(dst, p, vec4(c, 1.0));
}
