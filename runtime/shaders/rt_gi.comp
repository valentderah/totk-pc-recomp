    if (sid != 0u && sid < 4096u && sval[sid * 6u + 4u].w > 0.5) return sval[sid * 6u + 4u].rgb;
    return vec3(0.0);
}
vec3 mat_look(uint k, uint sid) {
    vec4 m = mval[k * 8u + 3u];
    if (m.w > 0.5) return m.rgb;
    if (sid != 0u && sid < 4096u && sval[sid * 6u + 3u].w > 0.5) return sval[sid * 6u + 3u].rgb;
    return vec3(1.0);
