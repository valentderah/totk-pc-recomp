    uint ni = h0.x, nsl = h2.z, flat_ = h2.w;
    uint slm = (xw >> 27) & 15u, xs = (slm == 15u ? 0u : slm) + 1u;   // the slots the draw recorded (the program's, then the UV's and layer's)
    if (h0.z > PROG_REGS || xs < nsl) return false;
