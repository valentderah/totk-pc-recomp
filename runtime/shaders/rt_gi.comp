#version 460
// Ray-traced one-bounce diffuse GI, the phase 7 cost probe (runtime/vk_rt.c, TOTK_RT_GI=1; docs/raytracing.md).
// Runs after the composite, on the lit HDR scene colour. Three modes, the AO's layout:
//
// mode 0, trace (quarter resolution, one thread per 4x4 block): one pixel of the block (a different one each frame), its
// world position and normal from the linear depth, one cosine-weighted ray of pc.prm.x metres. A hit whose point is on
// the screen and not hidden there takes the lit colour of that pixel (this frame's, before GI: one bounce); a hit off the
// screen or hidden, and a miss, bring nothing (the game's own ambient keeps the sky light). The history at the point's
// position last frame is reprojected. hist_out[i] = (history rgb or raw, view depth), hist_out[n + i] = (raw rgb, frames),
// hist_out[2n + i] = (sky visibility history or raw, raw): 1 for a miss, (t / length)^2 for a hit at t. rt_aoinj.comp
// dims the game's ambient by it before the next composite (the ambient rebalance).
//
// mode 3, temporal (quarter resolution): the history clamped to the 3x3 neighbourhood's raw mean +- 2 sd (same depth),
// then blended with the raw value over up to 32 frames.
//
// mode 1, apply (full resolution): a depth-aware 3x3 upsample of the quarter-res GI, times the surface colour (the
// G-buffer's albedo when found, else the lit colour's chroma), times pc.prm.y, added to the scene.
// view 20: the GI light alone (times pc.ext.y); 21: split screen, GI on the left half, none on the right (the ambient
// rebalance, applied before the composite, is on both halves); 22: the sky visibility; 23: the pixels that count as
// lights (red); 24: the reflections alone (times their weight); 25: the reflection weight (Fresnel x gloss x found);
// 28: the material targets (red: the reflection weight from the material, green: the game's smoothness; blue: none bound).
//
// Reflections (pc.rfl.x > 0; the UltraCam RTGI's glossy floors), half resolution, their buffer bound at 2 for the apply:
// mode 8, trace (one thread per 2x2 block, a different pixel of it each frame): the mirror direction from the depth
// normal, jittered by the roughness; a hit on the screen and not hidden there takes that pixel's lit colour, a miss whose
// vanishing point on the screen is sky or farther than the ray takes that; anything else is not found. Values are kept
// premultiplied, (rgb x found, found). The gloss: planar surfaces (the normal matches its neighbours' 3 pixels away)
// reflect, curved ones (characters, rocks) do not. r[i] = reprojected history, r[n + i] = raw, r[2n + i] = (view depth,
// frames, gloss, -).
// mode 9, temporal: the history clamped to the 3x3 raw mean +- 1.5 sd, blended over up to pc.rfl.w frames.
// mode 10, spatial: one a-trous step (like mode 7) on the premultiplied values.
// The apply mixes the scene towards the reflection by Fresnel (Schlick; F0 pc.rsz.z on floors, polished or wet, 0.04 on
// walls) x gloss x found x strength. Then the night tone (pc.tone, vk_rt.c: by the frame's lighting level) scales it.
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D lin_depth;              // the game's linear depth: (view distance - near) / far
layout(binding = 1, r11f_g11f_b10f) uniform image2D scene;    // the lit scene colour (HDR, before tonemapping)
layout(binding = 2, std430) readonly buffer HistIn { vec4 hist_in[]; };
layout(binding = 3, std430) buffer HistOut { vec4 hist_out[]; };
layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 4, std430) readonly buffer World { vec4 world[]; };
layout(binding = 5, std430) readonly buffer Gtab { uint gtab[]; };
layout(binding = 7) uniform sampler2D albedo;                 // the G-buffer's albedo (sRGB view: linear when read)
// The G-buffer's material targets (vk_contact.c, bound when pc.rsz.z < 0): target 3 (RGBA8) holds the packed normal in
// rg, baked AO in b (bits 2-7, its sqrt) and the material texture's smoothness in a (bits 2-7); target 0 (RGBA8) the
// shading class: g 253 characters (r 8-11 the part), g 125 foliage, g 32 trees and far cards, r 128 far terrain.
layout(binding = 13) uniform sampler2D gmtl;
layout(binding = 14) uniform sampler2D gmid;
// The G-buffer's glow: the scene colour before the lighting composite added the light (vk_rt.c emit_copy), bound when
// pc.ext.w < 0. What the game's shaders say glows, and how brightly: the GI's lights (is_light), not guessed from a
// pixel's brightness over its albedo, which also took dark surfaces lit by strong light for lamps (the shrine
// doorway's interior, lit green, re-emitted 8 x).
layout(binding = 15) uniform sampler2D emis;
// The veil (rt_late.comp mode 2, last frame's, valid when pc.ext.x < 0): how much of a pixel the game's passes after the
// GI let show. The light the GI takes from the screen (bounce, the light cache, reflections, the glow's lights) is the
// screen at the composite times it, so what a veil covers (the shrine's portal) does not light the scene.
layout(binding = 16) uniform sampler2D veil;
// What apply added to each pixel (its GI and reflections; cleared to 0 each frame, vk_rt.c): the late measure takes it
// out of the finished picture, so the appearance cache learns the game's picture, not ours, and the GI's hits off the
// screen do not read the GI back (a loop: the shrine doorway's green rose until it saturated)
layout(binding = 6, rgba16f) uniform writeonly image2D added;   // a: the luminance apply wrote (covered later: not ours)
// The frame's light list (modes 5, 4): one entry per 4x4 block whose lit colour is at least the threshold (lanterns,
// crystals, lit windows): (world position, area m^2), (radiance times the emissive gain, -)
// lsum, lnum (mode 6): the frame's lighting level, the sum (x 64) and count of lit colour / albedo over the blocks
// the world-space light cache (vk_rt.c gcache): CN slots, a key (0: empty) and the lit colour + the frame it was written
#define CN 524288u
layout(binding = 9, std430) buffer Cache { uint ckey[CN]; vec4 cval[]; };
layout(binding = 8, std430) buffer Lights { uint lcount; uint lsum, lnum, skysum, skynum, lp0, lp1, lp2; vec4 lights[]; };   // sky: the night tone's day signal
#define LMAX 32768u
// Materials (vk_rt.c gsun, wattr, MT; docs/raytracing.md, materials step 4): the sun's measurement (mode 12: the lit colour / albedo
// summed x 64 where the sun reaches, with N.L x 1024, and where it does not), the sun's world direction (w: known),
// its colour and the sky's (w: measured); the triangles' UVs and texture words; the albedo textures
// ssum: in the sun (N.L > 0.25) the lit colour x 64 (0-2), the count (3), the albedo x 256 (4-6), the albedo x N.L x 256
// (7-9); in its shadow the lit colour x 64 (10-12), the albedo x 256 (13-15), the count (16). shist: histograms of the
// lit / albedo luminance ratio, 4 bins a stop from 2^-6: in the shadow (0-63), in the sun over N.L (64-127); vk_rt.c takes
// their medians for the levels (a block the capture misjudges, under glass or a cloud, cannot pull them far).
// mprobe (debug view 26, TOTK_RT_MPROBE): the materials primary rays hit at 32 points of the right half
layout(binding = 10, std430) buffer Sun { uint ssum[32]; uint shist[128]; uvec4 mprobe[96]; uint fsum[256];
                                           vec4 sun_dir; vec4 sun_col; vec4 sky_col; vec4 pbox; vec4 hz[32]; };
// The game's distance haze (fsum: mat_measure's sums per distance bin, 2 a stop from HZ_D0; hz: vk_rt.c haze_fit):
// hz[0] (extinction per metre rgb, w 1 when fitted), hz[1] (the haze's colour rgb): c T + colour (1 - T), T = e^(-sigma t)
#define HZ_D0 16.0
vec3 haze(vec3 c, float t) {
    if (hz[0].w < 0.5) return c;
    vec3 T = exp(-hz[0].rgb * t);
    return c * T + hz[1].rgb * (1.0 - T);
}
layout(binding = 11, std430) readonly buffer WAttr { vec4 wattr[]; };
// view 26's right half when the late hook puts it in (nr.z; rt_late.comp mode 1, after the late measure has read the
// game's whole picture): per pixel (colour, its weight over the game's finished pixel) as halves
layout(binding = 12, std430) writeonly buffer Split { uvec2 split[]; };
layout(set = 2, binding = 0) uniform sampler2D mtex[8192];
layout(set = 2, binding = 1) uniform sampler2DArray mtexa[8192];
layout(set = 2, binding = 2, std430) readonly buffer MGen { uint mgen[]; };
// The materials' measured colours (vk_rt.c MT.cal; rt_gi.comp mode 13 sums, mode 14 updates). Per slot 64 uints, x 64
// (rounded at random, so small values sum without bias): the diffuse colour the sun gives Ss (25-27), 28 the count, the
// finished screen's colour F there (29-31, the haze taken out), the diffuse colour the sky gives Sa (32-34);
// rt_late.comp's late measure, else mode 13 with the scene at GI time; then Ss^2 35-37, Sa^2 38-40, Ss Sa 41-43, R^2
// 44-46, Ss R 47-49, Sa R 50-52, F Ss 53-55, F Sa 56-58, F R 59-61 with R the Fresnel-weighted light a mirror ray
// brings, for mode 14's fit F = look Ss + ambient look Sa + spec R. Before that, x 4096
// the G-buffer albedo a (0-2), the raw texel t (3-5), t^2 (6-8), a t (9-11); the count (12); the generation + 1 the sums
// are of (14), the generation + 1 measured (15); x 64 the lit colour (16-18) and the lit colour where it glows (is_light,
// 19-21). Then per slot three vec4: (the fit's scale, the mean texel's red), (its offset, green): albedo = scale x
// texel + offset; (the light it gives off, blue): where the albedo is black (shaded by the game elsewhere: far impostors,
// effects) the lit colour the screen shows, else the glowing part's; (the look, w 1 once measured: mat_look); 4, 5
// debug; 6 the reflection strength (mat_spec); 7 the ambient look (mat_alook).
// sval: per fragment shader id (mgen's second half per slot; 0 none) its materials' fit averaged (scale, w 1 once set;
// offset; emission; look; reflection; ambient look), which a material not measured yet takes
// mrec (rt_gi.comp mode 13 -> rt_late.comp): three records a 4x4 block for the late measure as halves: (slot + 1, pixel
// and frame, Ss, the distance), (Sa, R, the cache's cell by colour + 1), (our diffuse colour there Lt, the reflection strength q, the appearance cache's
// cell + 1, 1 where it glows).
// mcache: the appearance cache (ac_get), 16 uints a cell: key, frame last measured, count, then x 1024 the sums of
// F' (the finished colour less q R), Lt F', Lt^2, Lt per channel
layout(set = 2, binding = 3, std430) buffer MCal { uint msum[2u * 8192u * 64u]; vec4 sval[4096u * 6u]; uvec4 mrec[3u * 522240u]; uint mcache[524288u * 16u];
                                                   vec4 mval[]; };
uint tri_index(int ci, int geom, int prim) { return (ci == 0 ? 0u : gtab[uint(ci - 2 + geom)]) + uint(prim); }
bool alpha_cut(uint ct, vec2 bc, float t, vec3 rd);
uint pcg(uint v);
float app_mode();
float lum(vec3 c);
#define PROCEED(q, dir) \
    while (rayQueryProceedEXT(q)) { \
        int ci_ = rayQueryGetIntersectionInstanceCustomIndexEXT(q, false); \
        uint ct_ = ci_ == 1 ? 0u : tri_index(ci_, rayQueryGetIntersectionGeometryIndexEXT(q, false), \
                                             rayQueryGetIntersectionPrimitiveIndexEXT(q, false)); \
        vec4 ca_ = ci_ == 1 ? vec4(0.0) : world[ct_ * 3u], cb_ = ci_ == 1 ? vec4(0.0) : world[ct_ * 3u + 1u], \
             cc_ = ci_ == 1 ? vec4(0.0) : world[ct_ * 3u + 2u]; \
        if ((ci_ == 1 || ca_.w > 1.5 || dot(cross(cb_.xyz - ca_.xyz, cc_.xyz - ca_.xyz), dir) < 0.0) && \
            (ci_ == 1 || !alpha_cut(ct_, rayQueryGetIntersectionBarycentricsEXT(q, false), rayQueryGetIntersectionTEXT(q, false), dir))) \
            rayQueryConfirmIntersectionEXT(q); \
    }
// the same for a ray toward the sun: both sides of a triangle block it (the game's shadow map draws its casters so: an
// open mesh's far side, a single-sided lattice, cast their shadows)
#define PROCEED_SUN(q, dir) \
    while (rayQueryProceedEXT(q)) { \
        int ci_ = rayQueryGetIntersectionInstanceCustomIndexEXT(q, false); \
        if (ci_ == 1 || !alpha_cut(tri_index(ci_, rayQueryGetIntersectionGeometryIndexEXT(q, false), \
                                             rayQueryGetIntersectionPrimitiveIndexEXT(q, false)), \
                                   rayQueryGetIntersectionBarycentricsEXT(q, false), rayQueryGetIntersectionTEXT(q, false), dir)) \
            rayQueryConfirmIntersectionEXT(q); \
    }

layout(push_constant) uniform Params {
    vec4 proj;             // projection x scale, y scale, far plane, mode (0 trace, 3 temporal, 1 apply)
    vec4 iv0, iv1, iv2;    // inverse view rows: view space -> world
    vec4 pv0, pv1, pv2, pv3;   // last frame's view-projection rows (clip = row . world)
    vec4 prm;              // ray length (m), strength, saturation, frame number
    vec4 sz;               // width, height, quarter width, quarter height
    vec4 flg;              // history valid, uv x sign, uv y sign, view
    vec4 ext;              // farthest pixel given GI (m), debug brightness, light threshold (negative: no albedo bound),
                           // emissive gain
    vec4 rfl;              // reflections: strength (0: off), roughness, ray length (m), history frames
    vec4 rsz;              // reflections: half width, half height, floors' F0 (walls 0.04), offset of the result in binding 2
    vec4 tone;             // the night tone: rgb gains, amount (0: none): the scene times mix(1, gains, amount)
    layout(offset = 240) vec4 nr;   // x: the near plane (m); the linear depth is (view distance - near) / far; y: mode 13
                                    // leaves records for the late measure; z: view 26's half goes to split; w: the
                                  // appearance cache on
} pc;
float thr() { return abs(pc.ext.z); }
float gfar() { return abs(pc.ext.x); }   // (negative: the veil is bound)

vec3 view_pos(vec2 uv, float z) {
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * z / pc.proj.x, -ndc.y * z / pc.proj.y, -z);
}
vec3 to_world(vec3 p) { vec4 q = vec4(p, 1.0); return vec3(dot(pc.iv0, q), dot(pc.iv1, q), dot(pc.iv2, q)); }
vec3 dir_world(vec3 d) { return vec3(dot(pc.iv0.xyz, d), dot(pc.iv1.xyz, d), dot(pc.iv2.xyz, d)); }
// world -> view space: the inverse view is a rotation and a translation
vec3 to_view(vec3 w) {
    vec3 d = w - vec3(pc.iv0.w, pc.iv1.w, pc.iv2.w);
    return vec3(dot(vec3(pc.iv0.x, pc.iv1.x, pc.iv2.x), d), dot(vec3(pc.iv0.y, pc.iv1.y, pc.iv2.y), d),
                dot(vec3(pc.iv0.z, pc.iv1.z, pc.iv2.z), d));
}

// ---- materials: a captured triangle's albedo (rt_test.comp and rt_gi.comp have the same code)
// The raw material at a hit of triangle ct (barycentrics bc, t along rd): 0 none (no material, or its slot went since);
// 1 a texel tx of the draw's texture at the mip of a one-pixel ray cone; 2 a flat material (tx 1); 3 a material whose
// slot was freed since (its texture went: the game streamed a new one in) but still holds its last measure. k: its slot
// (2D slots, then array ones). atest: the draw is alpha-tested.
// The last mat_raw's place on its texture (type 1): x, y in the appearance cache's cells by texture, the layer; w the
// cells a side (0: none): at most 64, fewer where a pixel covers more than a cell (mip levels: a far pixel's colour is
// the average of several cells' and would wash out the near ones')
vec4 g_uv = vec4(0.0);
uint mat_raw(uint ct, vec2 bc, float t, vec3 rd, out vec4 tx, out uint k, out bool atest) {
    tx = vec4(1.0), k = 0u, atest = false, g_uv = vec4(0.0);
    if (uint(wattr.length()) <= ct * 2u + 1u) return 0u;
    vec4 a = wattr[ct * 2u], b = wattr[ct * 2u + 1u];
    uint lz = floatBitsToUint(b.z), tw = floatBitsToUint(b.w), fl = lz >> 16;
    atest = (fl & 4u) != 0u;
    if ((fl & 9u) == 0u || (tw & 0x80000000u) == 0u) return 0u;
    uint slot = tw & 0xffffu, arr = (tw >> 30) & 1u;
    if (slot >= 8192u) return 0u;
    k = arr * 8192u + slot;
    if (mgen[k] != ((tw >> 16) & 0x3fffu)) return msum[k * 64u + 15u] == ((tw >> 16) & 0x3fffu) + 1u ? 3u : 0u;
    if ((fl & 1u) == 0u) return 2u;
    vec2 uv = a.xy * (1.0 - bc.x - bc.y) + a.zw * bc.x + b.xy * bc.y;
    vec3 p0 = world[ct * 3u].xyz, p1 = world[ct * 3u + 1u].xyz, p2 = world[ct * 3u + 2u].xyz;
    vec3 nc = cross(p1 - p0, p2 - p0);
    float aw = length(nc);
    vec3 n = nc / max(aw, 1e-20);
    vec2 d1 = a.zw - a.xy, d2 = b.xy - a.xy;
    float at = abs(d1.x * d2.y - d1.y * d2.x);
    ivec2 ts = arr != 0u ? textureSize(mtexa[nonuniformEXT(slot)], 0).xy : textureSize(mtex[nonuniformEXT(slot)], 0);
    float spread = 2.0 / (pc.proj.y * pc.sz.y);   // a pixel's angle
    float lod = 0.5 * log2(max(at * float(ts.x) * float(ts.y), 1e-20) / max(aw, 1e-20)) +
                log2(max(t * spread, 1e-6) / max(abs(dot(n, rd)), 0.1));
    tx = arr != 0u ? textureLod(mtexa[nonuniformEXT(slot)], vec3(uv, float(lz & 0xffffu)), lod)
                   : textureLod(mtex[nonuniformEXT(slot)], uv, lod);
    // Single-channel (BC4 / R8) mask textures sample as (r, 0, 0, 1) in Vulkan; broadcast to greyscale so trim masks
    // do not render or fit as pure neon red.
    if (max(tx.g, tx.b) == 0.0 && tx.r > 0.0) tx.gb = vec2(tx.r);
    float tm = float(max(ts.x, ts.y)), c0 = min(tm, 64.0);
    float cn = max(c0 * exp2(-clamp(ceil(lod - log2(tm / c0) - 0.5), 0.0, 6.0)), 1.0);
    g_uv = vec4(uv * cn, float(lz & 0xffffu), cn);
    return 1u;
}
// ---- step 6 (docs/raytracing.md, materials): the game's own fragment shader at a hit. gfx_prog.c compiled its albedo (target 1) and
// glow (target 5) to a register program (pcode); a draw that used it recorded its corners' varyings (pext; wext points
// a triangle at its first corner's) and its textures and uniforms (pmat, per material slot: the program + 1, the material
// word it was written for, 8 texture words, the uniforms). Opcodes: gfx.h GP_*.
layout(set = 2, binding = 4, std430) readonly buffer PCode { uvec4 pcode[]; };
layout(set = 2, binding = 5, std430) readonly buffer PMat { uint pmat[]; };
layout(set = 2, binding = 6, std430) readonly buffer PExt { vec4 pext[]; };
layout(set = 2, binding = 7, std430) readonly buffer PWext { uint wext[]; };
#define PROG_REGS 112u   // the program's constants, then its registers (gfx_prog.c finish)
#define PM_WORDS 64u
// a program texture (the record's word: the bindless table's slot and generation), at lodw (log2 of the ray cone's
// footprint in UV units) for its size, or the program's own LOD (mode 1) or bias (2); fetch: integer texels
vec4 prog_tex(uint w, uvec3 c, uint mode, uint lv, bool fetch, float lodw) {
    if ((w & 0x80000000u) == 0u) return vec4(0.0);
    uint slot = w & 0xffffu, arr = (w >> 30) & 1u;
    if (slot >= 8192u || mgen[arr * 8192u + slot] != ((w >> 16) & 0x3fffu)) return vec4(0.0);
    if (fetch) {
        ivec3 ic = ivec3(c);
        int l = int(lv);
        return arr != 0u ? texelFetch(mtexa[nonuniformEXT(slot)], ic, l) : texelFetch(mtex[nonuniformEXT(slot)], ic.xy, l);
    }
    vec3 fc = uintBitsToFloat(c);
    ivec2 ts = arr != 0u ? textureSize(mtexa[nonuniformEXT(slot)], 0).xy : textureSize(mtex[nonuniformEXT(slot)], 0);
    float fl = uintBitsToFloat(lv);
    float lod = mode == 1u ? fl : lodw + 0.5 * log2(max(float(ts.x) * float(ts.y), 1.0)) + (mode == 2u ? fl : 0.0);
    return arr != 0u ? textureLod(mtexa[nonuniformEXT(slot)], fc, lod) : textureLod(mtex[nonuniformEXT(slot)], fc.xy, lod);
}
uint prog_ext1(uint e, uint a) {
    float x = uintBitsToFloat(a);
    int i = int(a);
    switch (e) {
    case 1u: return floatBitsToUint(round(x)); case 2u: return floatBitsToUint(roundEven(x)); case 3u: return floatBitsToUint(trunc(x));
    case 4u: return floatBitsToUint(abs(x)); case 5u: return uint(abs(i)); case 6u: return floatBitsToUint(sign(x));
    case 7u: return uint(sign(i)); case 8u: return floatBitsToUint(floor(x)); case 9u: return floatBitsToUint(ceil(x));
    case 10u: return floatBitsToUint(fract(x)); case 11u: return floatBitsToUint(radians(x)); case 12u: return floatBitsToUint(degrees(x));
    case 13u: return floatBitsToUint(sin(x)); case 14u: return floatBitsToUint(cos(x)); case 15u: return floatBitsToUint(tan(x));
    case 16u: return floatBitsToUint(asin(x)); case 17u: return floatBitsToUint(acos(x)); case 18u: return floatBitsToUint(atan(x));
    case 27u: return floatBitsToUint(exp(x)); case 28u: return floatBitsToUint(log(x)); case 29u: return floatBitsToUint(exp2(x));
    case 30u: return floatBitsToUint(log2(x)); case 31u: return floatBitsToUint(sqrt(x)); case 32u: return floatBitsToUint(inversesqrt(x));
    case 73u: return uint(findLSB(a)); case 74u: return uint(findMSB(i)); case 75u: return uint(findMSB(a));
    }
    return 0u;
}
uint prog_ext2(uint e, uint a, uint b) {
    float x = uintBitsToFloat(a), y = uintBitsToFloat(b);
    switch (e) {
    case 25u: return floatBitsToUint(atan(x, y)); case 26u: return floatBitsToUint(pow(x, y));
    case 37u: return floatBitsToUint(min(x, y)); case 38u: return min(a, b); case 39u: return uint(min(int(a), int(b)));
    case 40u: return floatBitsToUint(max(x, y)); case 41u: return max(a, b); case 42u: return uint(max(int(a), int(b)));
    case 48u: return floatBitsToUint(step(x, y)); case 53u: return floatBitsToUint(ldexp(x, int(b)));
    case 79u: return floatBitsToUint(isnan(x) ? y : isnan(y) ? x : min(x, y));
    case 80u: return floatBitsToUint(isnan(x) ? y : isnan(y) ? x : max(x, y));
    case 58u: return packHalf2x16(vec2(x, y));
    case 60u: return floatBitsToUint(unpackSnorm2x16(a)[min(b, 1u)]); case 61u: return floatBitsToUint(unpackUnorm2x16(a)[min(b, 1u)]);
    case 62u: return floatBitsToUint(unpackHalf2x16(a)[min(b, 1u)]); case 63u: return floatBitsToUint(unpackSnorm4x8(a)[min(b, 3u)]);
    case 64u: return floatBitsToUint(unpackUnorm4x8(a)[min(b, 3u)]);
    }
    return 0u;
}
uint prog_ext3(uint e, uint a, uint b, uint c) {
    float x = uintBitsToFloat(a), y = uintBitsToFloat(b), z = uintBitsToFloat(c);
    switch (e) {
    case 43u: return floatBitsToUint(min(max(x, y), z)); case 44u: return min(max(a, b), c);
    case 45u: return uint(min(max(int(a), int(b)), int(c))); case 46u: return floatBitsToUint(mix(x, y, z));
    case 49u: return floatBitsToUint(smoothstep(x, y, z)); case 50u: return floatBitsToUint(fma(x, y, z));
    case 81u: return floatBitsToUint(isnan(x) ? y : clamp(x, y, z));
    }
    return 0u;
}
uint prog_cmp(uint op, uint un, float x, float y) {
    bool n = isnan(x) || isnan(y), r;
    switch (op) {
    case 33u: r = x == y; break; case 34u: r = x != y && !n; break; case 35u: r = x < y; break;
    case 36u: r = x > y; break; case 37u: r = x <= y; break; default: r = x >= y; break;
    }
    return (un != 0u ? (n || r) : (!n && r)) ? 1u : 0u;
}
// The program of material k at triangle ct (barycentrics bc): albedo and glow; false where there is none
int g_prog_st = 0;   // (debug) 0 no program, 1 no record or pointer, 2 ran
bool prog_run(uint k, uint ct, vec2 bc, float lodw, out vec3 alb, out vec3 glow) {
    alb = vec3(0.0), glow = vec3(0.0), g_prog_st = 0;
    if (k >= 16384u || uint(wext.length()) <= ct || uint(pmat.length()) < (k + 1u) * PM_WORDS) return false;
    uint mb = k * PM_WORDS, po = pmat[mb];
    if (po == 0u) return false;
    g_prog_st = 1;
    uint xw = wext[ct];
    if (xw == 0u) return false;
