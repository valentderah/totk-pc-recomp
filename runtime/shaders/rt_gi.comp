    if ((xw & 0x80000000u) != 0u) wt = wt.xzy;   // the triangle's corners 1 and 2 were swapped (rt_unproject.comp)
    uint R[PROG_REGS];
    for (uint i = 0u; i < min(h0.y, PROG_REGS); i++) R[i] = pcode[cb + (i >> 2u)][i & 3u];
    for (uint sl = 0u; sl < ((h0.w & 0x8000u) != 0u ? 0u : nsl); sl++) {   // the varyings, interpolated (flat: the first corner's)
        vec4 v = pext[xb + sl];
        if ((flat_ >> sl & 1u) == 0u) v = wt.x * v + wt.y * pext[xb + xs + sl] + wt.z * pext[xb + 2u * xs + sl];
        uint vr = h0.y + 4u * sl;
        for (uint q = 0u; q < 4u; q++) R[min(vr + q, PROG_REGS - 1u)] = floatBitsToUint(v[q]);
    }
    for (uint u = 0u, ub = h0.y + 4u * nsl; u < (h0.w >> 16); u++) R[min(ub + u, PROG_REGS - 1u)] = pmat[mb + 10u + min(u, 53u)];
#define PRD(o) R[min((o), PROG_REGS - 1u)]
    for (uint i = 0u; i < ni; i++) {
        uvec4 I = pcode[h + 3u + i];
        uint op = I.x & 255u, d = min((I.x >> 8) & 0xfffu, PROG_REGS - 1u), aux = I.x >> 20;
        uint a = PRD(I.y), b = PRD(I.z), c = PRD(I.w), r = 0u;
