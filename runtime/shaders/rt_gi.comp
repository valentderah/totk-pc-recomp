vec3 g_tx = vec3(1.0);   // its raw texel (1 for a flat material)
vec3 mat_alook(uint k, uint sid) {
    vec4 m = mval[k * 8u + 7u];
    if (m.w > 0.5) return m.rgb;
    if (sid != 0u && sid < 4096u && sval[sid * 6u + 5u].w > 0.5) return sval[sid * 6u + 5u].rgb;
    return mat_look(k, sid);
}
// The albedo at a hit: its material's measured fit, scale x texel + offset (rt_gi.comp mat_update), which is the texel
// times a tint where the texture is the albedo, and falls back towards the material's mean colour where the texture
// does not follow the screen (a texture that is not the albedo, or a UV that is not its UV); a flat material (tx 1) gets
// its mean colour. A texture not measured yet: the texel as it is. false: no material, or a flat one not measured yet.
// st (debug view 17): 1 texture unmeasured, 2 mostly the texture, 3 mostly the offset (the texture explains little),
// 4 flat, 5 flat unmeasured, 6 not measured: its shader's average fit, 7 its texture went: the fit at the mean texel
// em: the light it gives off (measured; 0 otherwise)
bool mat_albedo(uint ct, vec2 bc, float t, vec3 rd, out vec3 alb, out int st, out vec3 em) {
