    }
    if (r == 3u) {
        vec4 s0 = mval[k * 8u], s1 = mval[k * 8u + 1u], s2 = mval[k * 8u + 2u];
        base = clamp(s0.rgb * vec3(s0.w, s1.w, s2.w) + s1.rgb, 0.0, 1.0), em = s2.rgb, st = 7;
        alb = clamp(base * mat_look(k, sid), 0.0, LOOK_MAX), g_amb = clamp(base * mat_alook(k, sid), 0.0, LOOK_MAX);
        g_spec = mat_spec(k, sid);
        return true;
    }
    bool meas = mat_measured(k);
    vec4 v0, v1;
    if (meas) {
        v0 = mval[k * 8u], v1 = mval[k * 8u + 1u], em = mval[k * 8u + 2u].rgb;
    } else {   // not measured: its shader's average fit, or the texel as it is
        if (sid == 0u || sid >= 4096u || sval[sid * 6u].w < 0.5) { alb = g_amb = tx.rgb, st = r == 2u ? 5 : 1; return r == 1u; }
        v0 = sval[sid * 6u], v1 = sval[sid * 6u + 1u], em = sval[sid * 6u + 2u].rgb;
        base = clamp(v0.rgb * tx.rgb + v1.rgb, 0.0, 1.0), st = 6;
        alb = clamp(base * mat_look(k, sid), 0.0, LOOK_MAX), g_amb = clamp(base * mat_alook(k, sid), 0.0, LOOK_MAX);
        g_spec = mat_spec(k, sid);
        return true;
    }
    base = clamp(v0.rgb * tx.rgb + v1.rgb, 0.0, 1.0);
    alb = clamp(base * mat_look(k, sid), 0.0, LOOK_MAX), g_amb = clamp(base * mat_alook(k, sid), 0.0, LOOK_MAX);
    g_spec = mat_spec(k, sid);
    float mtl = dot(vec3(v0.w, v1.w, mval[k * 8u + 2u].w), vec3(0.2126, 0.7152, 0.0722));   // the mean texel's luminance
    st = r == 2u ? 4 : dot(v0.rgb, vec3(1.0)) * mtl >= dot(max(v1.rgb, 0.0), vec3(1.0)) ? 2 : 3;
    return true;
}
// an alpha-tested triangle's candidate hit where its albedo's alpha is below 0.5 (the shader discards there)
bool alpha_cut(uint ct, vec2 bc, float t, vec3 rd) {
    if (uint(wattr.length()) <= ct * 2u + 1u || ((floatBitsToUint(wattr[ct * 2u + 1u].z) >> 16) & 4u) == 0u) return false;
    vec4 tx;
    uint k;
    bool at;
    return mat_raw(ct, bc, t, rd, tx, k, at) == 1u && tx.a < 0.5;
}
bool sun_known() { return sun_dir.w > 0.5; }
// The light a hit at hp (normal n, facing the ray) gets: the sky's colour, plus the sun's x N.L where a ray toward the
// sun is not blocked (its length 1 km; the captured scene reaches about 2 km)
vec3 sky_light() { return sky_col.w > 0.5 ? sky_col.rgb : vec3(0.0); }
// the sun's part of it alone
vec3 hit_sun(vec3 hp, vec3 n, float t) {
    vec3 e = vec3(0.0);
