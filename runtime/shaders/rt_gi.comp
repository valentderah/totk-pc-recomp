        if (aux != 0u && ((op >= 4u && op <= 7u) || op == 11u)) {   // operands negated (gfx_prog.c peephole)
            if ((aux & 1u) != 0u) fa = -fa;
            if ((aux & 2u) != 0u) fb = -fb;
            if ((aux & 4u) != 0u) fc = -fc;
        }
        if (op == 59u || op == 60u) {   // GP_SMP, GP_FETCH: four registers; the LOD in the ARG after
            uint lv = PRD(pcode[h + 4u + i].y);
            vec4 tv = prog_tex(pmat[mb + 2u + min(aux & 31u, 7u)], uvec3(a, b, c), (aux >> 5) & 3u, lv, op == 60u, lodw);
            for (uint q = 0u; q < 4u; q++) R[min(d + q, PROG_REGS - 1u)] = floatBitsToUint(tv[q]);
            i++;
            continue;
        }
        if (op == 61u) {   // GP_TSIZE
            uint w = pmat[mb + 2u + min(aux & 31u, 7u)], slot = w & 0xffffu;
            ivec3 ts = ivec3(0);
            if ((w & 0x80000000u) != 0u && slot < 8192u)
                ts = (w & 0x40000000u) != 0u ? textureSize(mtexa[nonuniformEXT(slot)], int(a)) : ivec3(textureSize(mtex[nonuniformEXT(slot)], int(a)), 1);
            for (uint q = 0u; q < 3u; q++) R[min(d + q, PROG_REGS - 1u)] = uint(ts[q]);
            continue;
        }
        switch (op) {
        case 1u: r = a; break;
        case 2u: {   // GP_LDV: the varying interpolated (flat: the first corner's)
            uint s = aux >> 2, q = aux & 3u;
            float v0 = pext[xb + s][q];
            r = (flat_ >> s & 1u) != 0u ? floatBitsToUint(v0) : floatBitsToUint(dot(wt, vec3(v0, pext[xb + xs + s][q], pext[xb + 2u * xs + s][q])));
            break;
        }
        case 3u: r = pmat[mb + 10u + min(aux, 53u)]; break;
        case 4u: r = floatBitsToUint(fa + fb); break; case 5u: r = floatBitsToUint(fa - fb); break;
        case 6u: r = floatBitsToUint(fa * fb); break; case 7u: r = floatBitsToUint(fa / fb); break;
        case 8u: r = floatBitsToUint(fa - fb * floor(fa / fb)); break; case 9u: r = floatBitsToUint(fa - fb * trunc(fa / fb)); break;
        case 10u: r = floatBitsToUint(-fa); break; case 11u: r = floatBitsToUint(fma(fa, fb, fc)); break;
        case 12u: r = a + b; break; case 13u: r = a - b; break; case 14u: r = a * b; break;
        case 15u: r = b == 0u ? 0xffffffffu : a / b; break; case 16u: r = b == 0u ? 0u : uint(int(a) / int(b)); break;
        case 17u: r = b == 0u ? 0u : a % b; break;
        case 18u: r = b == 0u ? 0u : uint(int(a) - int(b) * (int(a) / int(b))); break;
        case 19u: { int m = b == 0u ? 0 : int(a) - int(b) * (int(a) / int(b)); if (m != 0 && ((m < 0) != (int(b) < 0))) m += int(b); r = uint(m); break; }
        case 20u: r = a & b; break; case 21u: r = a | b; break; case 22u: r = a ^ b; break; case 23u: r = ~a; break;
        case 24u: r = a << (b & 31u); break; case 25u: r = a >> (b & 31u); break; case 26u: r = uint(int(a) >> int(b & 31u)); break;
        case 27u: r = isnan(fa) ? 0u : uint(max(fa, 0.0)); break; case 28u: r = isnan(fa) ? 0u : uint(int(fa)); break;
        case 29u: r = floatBitsToUint(float(a)); break; case 30u: r = floatBitsToUint(float(int(a))); break;
        case 31u: r = isnan(fa) ? 1u : 0u; break; case 32u: r = isinf(fa) ? 1u : 0u; break;
        case 33u: case 34u: case 35u: case 36u: case 37u: case 38u: r = prog_cmp(op, aux & 1u, fa, fb); break;
        case 39u: r = a == b ? 1u : 0u; break; case 40u: r = a != b ? 1u : 0u; break;
        case 41u: r = a > b ? 1u : 0u; break; case 42u: r = int(a) > int(b) ? 1u : 0u; break;
        case 43u: r = a >= b ? 1u : 0u; break; case 44u: r = int(a) >= int(b) ? 1u : 0u; break;
        case 45u: r = a < b ? 1u : 0u; break; case 46u: r = int(a) < int(b) ? 1u : 0u; break;
        case 47u: r = a <= b ? 1u : 0u; break; case 48u: r = int(a) <= int(b) ? 1u : 0u; break;
        case 49u: r = (a != 0u && b != 0u) ? 1u : 0u; break; case 50u: r = (a != 0u || b != 0u) ? 1u : 0u; break;
        case 51u: r = a == 0u ? 1u : 0u; break;
        case 52u: r = a != 0u ? b : c; break;
        case 53u: r = bitfieldExtract(a, int(min(b, 31u)), int(min(c, 32u - min(b, 31u)))); break;
        case 54u: r = uint(bitfieldExtract(int(a), int(min(b, 31u)), int(min(c, 32u - min(b, 31u))))); break;
        case 55u: { uint cnt = PRD(pcode[h + 4u + i].y); r = bitfieldInsert(a, b, int(min(c, 31u)), int(min(cnt, 32u - min(c, 31u)))); i++; break; }
        case 56u: r = prog_ext1(aux, a); break;
        case 57u: r = prog_ext2(aux, a, b); break;
        case 58u: r = prog_ext3(aux, a, b, c); break;
        default: break;
        }
        R[d] = r;
    }
    alb = vec3(uintBitsToFloat(PRD(h1.x)), uintBitsToFloat(PRD(h1.y)), uintBitsToFloat(PRD(h1.z)));
    glow = vec3(uintBitsToFloat(PRD(h1.w)), uintBitsToFloat(PRD(h2.x)), uintBitsToFloat(PRD(h2.y)));
#undef PRD
    if (any(isnan(alb)) || any(isinf(alb))) return false;
    if (any(isnan(glow)) || any(isinf(glow))) glow = vec3(0.0);
    g_prog_st = 2;
    return true;
}
vec3 prog_err_col(vec3 e) { float m = max(e.r, max(e.g, e.b)); return m < 0.02 ? vec3(0.0, 4.0, 0.0) : m < 0.05 ? vec3(4.0, 4.0, 0.0) : vec3(4.0, 0.0, 0.0); }
// the program at a hit: lodw from the albedo UV's density on the triangle (UV area over world area) and the ray cone
bool prog_hit(uint k, uint ct, vec2 bc, float t, vec3 rd, out vec3 alb, out vec3 glow) {
    alb = vec3(0.0), glow = vec3(0.0);
    if (uint(wattr.length()) <= ct * 2u + 1u) return false;
    vec4 a = wattr[ct * 2u], b = wattr[ct * 2u + 1u];
    vec3 p0 = world[ct * 3u].xyz, p1 = world[ct * 3u + 1u].xyz, p2 = world[ct * 3u + 2u].xyz;
    vec3 nc = cross(p1 - p0, p2 - p0);
    float aw = length(nc);
    vec2 d1 = a.zw - a.xy, d2 = b.xy - a.xy;
    float at = abs(d1.x * d2.y - d1.y * d2.x);
    if (!(at > 0.0) || ((floatBitsToUint(b.z) >> 16) & 1u) == 0u) at = aw;   // no UV: one UV unit a metre
    float spread = 2.0 / (pc.proj.y * pc.sz.y);
    float lodw = 0.5 * log2(max(at, 1e-20) / max(aw, 1e-20)) + log2(max(t * spread, 1e-6) / max(abs(dot(nc / max(aw, 1e-20), rd)), 0.1));
    if (k >= 16384u || uint(pmat.length()) < (k + 1u) * PM_WORDS || pmat[k * PM_WORDS + 1u] != floatBitsToUint(b.w)) return false;
    return prog_run(k, ct, bc, lodw, alb, glow);
}
// slot k's colour measured on screen (rt_gi.comp mode 14 wrote it for its current generation)
bool mat_measured(uint k) { return msum[k * 64u + 15u] == mgen[k] + 1u; }
// The look: what the finished screen shows over the diffuse light the albedo gets (per channel; mode 14 from
// vk_rt_tone_scene's late measure: the game's character shading, specular and reflections), 1 unknown. The albedo
// times this is the colour a lit hit takes.
// (the albedo times the look may pass 1, to LOOK_MAX: glassy, glowing or glossy surfaces the game shows brighter than a
// white diffuse one)
#define LOOK_MAX 4.0
// The reflection: what the finished screen shows beyond the diffuse colour, as light a mirror ray brings in weighted by
// Fresnel (mode 14's fit F = look S + spec R, per channel), 0 unknown. mat_albedo leaves it in g_spec.
vec3 g_spec = vec3(0.0);
vec3 mat_spec(uint k, uint sid) {
