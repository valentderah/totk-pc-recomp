<Window x:Class="TotKLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TotK Recomp" Width="960" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource Ui}">

  <!-- A fixed-size window with its own title bar; Backdrop.cs puts the Windows 11 acrylic behind it -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A0E1A1C" Offset="0"/>
        <GradientStop Color="#55101517" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <!-- ===================== splash: the icon inside a spinning arc ===================== -->
    <Grid x:Name="Splash" Panel.ZIndex="4">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="150" Height="150">
          <Ellipse Stroke="{StaticResource Line}" StrokeThickness="3"/>
          <Path Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M75,1.5 A73.5,73.5 0 0 1 148.5,75" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform x:Name="SpinTurn"/></Path.RenderTransform>
          </Path>
          <Image Source="pack://application:,,,/Images/totk.png" Width="96" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <TextBlock Text="TotK Recomp" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0"/>
        <TextBlock x:Name="SplashText" Text="Starting…" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"
                   Margin="0,6,0,0" MinHeight="18"/>
      </StackPanel>
    </Grid>

    <!-- ===================== the installer / launcher ===================== -->
    <Grid x:Name="Main" Opacity="0" IsHitTestVisible="False">
      <Grid.RenderTransform><TranslateTransform x:Name="MainLift" Y="12"/></Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- title bar: icon and name, then the stepper (or the version tag of an update, verify or rebuild) -->
      <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Images/totk.png" Width="24" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="TotK Recomp" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <Border x:Name="VersionTag" Margin="14,0,0,0" Padding="9,3" CornerRadius="4" Background="{StaticResource AccentSoft}"
                VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="VersionTagText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentLight}"/>
        </Border>
      </StackPanel>
      <StackPanel x:Name="Stepper" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <Grid Grid.Row="1" Margin="56,12,56,30">

        <!-- ===== 1: game files ===== -->
        <Grid x:Name="FilesPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="FilesTitle" Style="{StaticResource H1}" Text="Install your game"/>
              <TextBlock x:Name="FilesSub" Style="{StaticResource Lead}"
                         Text="Pick your game files and where the game should go. The installer builds the game on your PC, once."/>

              <TextBlock Style="{StaticResource Caps}" Text="GAME FILES"/>
              <Border Style="{StaticResource Panel}" Padding="16,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Base game" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tiny}" Text="NSP, XCI, NSZ or XCZ"/>
                  </StackPanel>
                  <TextBox x:Name="BasePath" Grid.Row="0" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,6" TextChanged="PathsChanged"/>
                  <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Btn}" Margin="10,0,0,0" Content="Browse" Tag="base" Click="BrowseFile"/>

                  <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Update" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tiny}" Text="1.1.0, 1.2.1 or 1.4.3 (NSP or NSZ)"/>
                  </StackPanel>
                  <TextBox x:Name="UpdatePath" Grid.Row="1" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,6" TextChanged="PathsChanged"/>
                  <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Margin="10,0,0,0" Content="Browse" Tag="update" Click="BrowseFile"/>

                  <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <TextBlock Text="prod.keys" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tiny}" Text="read in place, never copied"/>
                  </StackPanel>
                  <TextBox x:Name="KeysPath" Grid.Row="2" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,6" TextChanged="PathsChanged"/>
                  <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Btn}" Margin="10,0,0,0" Content="Browse" Tag="keys" Click="BrowseFile"/>

                  <StackPanel Grid.Row="3" VerticalAlignment="Center">
                    <TextBlock Text="Firmware (optional)" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tiny}" Text="only for Chinese and Korean"/>
                  </StackPanel>
                  <TextBox x:Name="FirmwarePath" Grid.Row="3" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,6" TextChanged="PathsChanged"/>
                  <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Btn}" Margin="10,0,0,0" Content="Browse" Click="BrowseFirmware"/>
                </Grid>
              </Border>
              <TextBlock Style="{StaticResource Tiny}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="You can also drop the files on this window. NSZ and XCZ work as they are: the installer decompresses them."/>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Caps}" Text="INSTALL THE GAME TO"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="OutPath" Style="{StaticResource PathBox}" TextChanged="PathsChanged"/>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Margin="10,0,0,0" Content="Change" Click="BrowseOut"/>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Caps}" Text="GAME LANGUAGE"/>
                  <ComboBox x:Name="LanguageBox" Style="{StaticResource Select}" AutomationProperties.Name="Game language" SelectionChanged="LanguageChanged"/>
                </StackPanel>
              </Grid>

              <!-- the setup package: the one on this PC, or the one the install downloads from the GitHub releases -->
              <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6" Background="{StaticResource AccentSoft}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                    <Ellipse Stroke="{StaticResource AccentLight}" StrokeThickness="1.3"/>
                    <Rectangle Width="1.6" Height="6" Fill="{StaticResource AccentLight}" Margin="0,3,0,0"/>
                    <Ellipse Width="2" Height="2" Fill="{StaticResource AccentLight}" VerticalAlignment="Top" Margin="0,3.2,0,0"/>
                  </Grid>
                  <TextBlock x:Name="PackageNote" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0"/>
                </Grid>
              </Border>

              <StackPanel Margin="0,16,0,0">
                <CheckBox x:Name="DlssTick" Style="{StaticResource Check}" IsChecked="True" Click="DlssChanged"
                          Content="Download NVIDIA DLSS (nvngx_dlss.dll) for NVIDIA RTX cards"/>
                <TextBlock Style="{StaticResource Tiny}" Margin="25,4,0,0" TextWrapping="Wrap"
                           Text="From NVIDIA's DLSS SDK on GitHub, under the NVIDIA RTX SDK license. Without it the dlaa and DLSS options of the menu (F1) do nothing."/>
              </StackPanel>

              <TextBlock x:Name="FormError" Style="{StaticResource Muted}" Foreground="{StaticResource Bad}" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="SpaceBar" Style="{StaticResource Meter}" Width="140" VerticalAlignment="Center"/>
            <TextBlock x:Name="SpaceText" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="BackToLauncher" Grid.Column="2" Style="{StaticResource TextLink}" Margin="0,0,18,0" VerticalAlignment="Center"
                    Content="Back to the launcher" Visibility="Collapsed" Click="BackToLauncherClick"/>
            <Button x:Name="BuildButton" Grid.Column="3" Style="{StaticResource BtnAccent}" Content="Install the game" IsEnabled="False" Click="StartInstall"/>
          </Grid>
        </Grid>

        <!-- ===== 2: install (and update, verify, rebuild) ===== -->
        <Grid x:Name="BuildPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="BuildTitle" Style="{StaticResource H1}" Text="Installing your game"/>
                <TextBlock x:Name="BuildNote" Style="{StaticResource Lead}" Margin="0,6,0,0"/>
              </StackPanel>
              <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource AccentLight}"
                         VerticalAlignment="Bottom"/>
            </Grid>
            <ProgressBar x:Name="OverallBar" Style="{StaticResource Meter}" Height="6" Margin="0,16,0,0"/>
            <TextBlock x:Name="WarnText" Style="{StaticResource Muted}" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,10,0,0"
                       Visibility="Collapsed"/>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,16,0,14">
            <Border x:Name="StepCard" Style="{StaticResource Panel}" Padding="16,2" VerticalAlignment="Top">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                <StackPanel x:Name="StageList"/>
              </ScrollViewer>
            </Border>
            <TextBox x:Name="Log" Visibility="Collapsed" IsReadOnly="True" BorderThickness="1" BorderBrush="{StaticResource Line}"
                     Background="#40000000" Foreground="{StaticResource TextDim}" FontFamily="{StaticResource Mono}" FontSize="11" Padding="10"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="ShowLog" Style="{StaticResource ToggleLink}" VerticalAlignment="Center" Content="Show details"
                          Checked="LogToggled" Unchecked="LogToggled"/>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource Btn}" Content="Cancel" Click="CancelRun"/>
          </Grid>
        </Grid>

        <!-- ===== 3: ready ===== -->
        <StackPanel x:Name="ReadyPage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid Width="72" Height="72" HorizontalAlignment="Center">
            <Ellipse Fill="{StaticResource OkSoft}" Stroke="{StaticResource Ok}" StrokeThickness="2"/>
            <Path Data="M0,11 L9,20 L26,2" Stroke="{StaticResource Ok}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="ReadyTitle" Style="{StaticResource H1}" Text="Your game is ready" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          <TextBlock x:Name="ReadyNote" Style="{StaticResource Lead}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="760"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource BtnPlay}" Click="Play">
              <StackPanel Orientation="Horizontal">
                <Path Data="M0,0 L11,7 L0,14 Z" Fill="{StaticResource GoldText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Play" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldText}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Btn}" Height="52" Margin="12,0,0,0" Padding="22,0" Content="Open folder" Click="OpenFolder"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <CheckBox x:Name="DesktopTick" Style="{StaticResource Check}" Content="Desktop shortcut" IsChecked="True" Click="ShortcutsChanged"/>
            <CheckBox x:Name="StartTick" Style="{StaticResource Check}" Content="Start menu shortcut" IsChecked="True" Margin="20,0,0,0" Click="ShortcutsChanged"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Tiny}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" MaxWidth="620" TextWrapping="Wrap"
                     Text="The shortcuts open this launcher: it looks for updates in the GitHub releases before it starts the game."/>
        </StackPanel>

        <!-- ===== launcher: opened by the shortcuts with the launch option and the game folder ===== -->
        <StackPanel x:Name="LaunchPage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Caps}" Text="THE LEGEND OF ZELDA" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Style="{StaticResource H1}" Text="Tears of the Kingdom" HorizontalAlignment="Center" FontSize="36" Margin="0,4,0,0"/>
          <TextBlock x:Name="LaunchVersion" Style="{StaticResource Lead}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="760"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="LaunchStatus" Style="{StaticResource Muted}" Text="Looking for updates…" HorizontalAlignment="Center" TextAlignment="Center"
                     Margin="0,16,0,0" MaxWidth="700"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button x:Name="LaunchUpdate" Style="{StaticResource BtnAccent}" Height="52" Padding="28,0" Margin="0,0,12,0" Content="Update"
                    Visibility="Collapsed" Click="LaunchUpdateClick"/>
            <Button x:Name="LaunchPlay" Style="{StaticResource BtnPlay}" Click="LaunchPlayClick">
              <StackPanel Orientation="Horizontal">
                <Path Data="M0,0 L11,7 L0,14 Z" Fill="{StaticResource GoldText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Play" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldText}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button Style="{StaticResource TextLink}" Content="Open the game folder" Click="LaunchFolderClick"/>
            <TextBlock Style="{StaticResource Tiny}" FontSize="13" Text="   |   " VerticalAlignment="Center"/>
            <Button Style="{StaticResource TextLink}" Content="Verify files" Click="LaunchVerifyClick"
                    ToolTip="Checks the hashes of everything the install recorded and redoes what is wrong"/>
            <TextBlock Style="{StaticResource Tiny}" FontSize="13" Text="   |   " VerticalAlignment="Center"/>
            <Button Style="{StaticResource TextLink}" Content="Install to another folder" Click="LaunchOtherClick"/>
          </StackPanel>
        </StackPanel>

        <!-- ===== when something goes wrong ===== -->
        <Grid x:Name="ProblemPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="ProblemTitle" Style="{StaticResource H1}" Text="The install stopped"/>
            <TextBlock x:Name="ProblemSub" Style="{StaticResource Lead}" Text="Finished steps are kept: trying again continues where it stopped."/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,20,0,14" VerticalAlignment="Top" ClipToBounds="True">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Rectangle Fill="{StaticResource Bad}"/>
              <StackPanel Grid.Column="1" Margin="20,18,20,18">
                <TextBlock x:Name="ProblemHead" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Text="What went wrong"/>
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock x:Name="ProblemText" Style="{StaticResource Muted}" FontSize="14"/>
                    <StackPanel x:Name="ProblemSteps" Margin="0,8,0,0"/>
                  </StackPanel>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ProblemDetails" Style="{StaticResource TextLink}" Content="Show details" Click="ProblemShowDetails"/>
              <TextBlock Style="{StaticResource Tiny}" FontSize="13" Text="   |   " VerticalAlignment="Center"/>
              <Button x:Name="CopyReport" Style="{StaticResource TextLink}" Content="Copy for a bug report" Click="CopyForReport"/>
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource Btn}" Content="Back" Click="Back"/>
            <Button x:Name="PlayAnyway" Grid.Column="2" Style="{StaticResource Btn}" Content="Play anyway" Margin="10,0,0,0" Visibility="Collapsed" Click="PlayAnywayClick"/>
            <Button x:Name="RetryButton" Grid.Column="3" Style="{StaticResource BtnAccent}" Content="Try again" Margin="10,0,0,0" Click="Retry"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- minimize and close, above everything -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Panel.ZIndex="9"
                WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource WinBtn}" Click="Minimize" ToolTip="Minimize">
        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button Style="{StaticResource WinClose}" Click="CloseWindow" ToolTip="Close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
